<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="theme-color" content="#08080e">
  <title>Cognitive CMA OS</title>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;700&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; margin:0; padding:0; }
    body { 
      background:#08080e; color:#e8e8f0; font-family:'IBM Plex Mono', monospace; 
      min-height:100vh; padding:20px; line-height:1.5;
    }
    .card { background:#0f0f1a; border:1px solid #252538; border-radius:12px; padding:16px; margin-bottom:16px; }
    button { background:#7c6aff; color:white; border:none; padding:14px; border-radius:8px; font-weight:700; width:100%; margin-top:8px; }
    input { width:100%; padding:12px; background:#1a1a2e; border:1px solid #252538; border-radius:8px; color:white; }
  </style>
</head>
<body>

  <h1 style="text-align:center; margin-bottom:20px;">Cognitive CMA OS</h1>
  <div class="card">
    <p>イベント入力</p>
    <input type="text" id="event" value="返信が来ない" placeholder="今起きていること...">
  </div>

  <div class="card">
    <p>ストレスレベル: <span id="stressVal">30</span>%</p>
    <input type="range" id="stress" min="0" max="100" value="30">
  </div>

  <button onclick="run()">▶ 実行</button>

  <div id="result" class="card" style="display:none;"></div>

<script>
// 簡易版CMAエンジン
class CognitiveCMAOS {
  run(event, stress) {
    const score = (event.length * 1.2) + (stress * 0.8);
    let verdict, label, color;
    if (score > 85) {
      verdict = "EMERGENCY";
      label = "⚠️ EMERGENCY — 思考停止・支援要請推奨";
      color = "#ef4444";
    } else if (score > 55) {
      verdict = "AVOID";
      label = "🟡 AVOID — 判断保留・距離を置く";
      color = "#f59e0b";
    } else {
      verdict = "OK";
      label = "✅ OK — 比較的安定";
      color = "#22c55e";
    }
    return {verdict, label, color, score: Math.min(99, Math.round(score))};
  }
}

function run() {
  const event = document.getElementById("event").value;
  const stress = parseInt(document.getElementById("stress").value);
  const result = new CognitiveCMAOS().run(event, stress);
  
  const resDiv = document.getElementById("result");
  resDiv.style.display = "block";
  resDiv.innerHTML = `
    <h2 style="color:${result.color}">${result.label}</h2>
    <p>総合スコア: ${result.score}点</p>
    <p style="font-size:13px; color:#888;">入力: ${event}</p>
  `;
}

// スライダー連動
document.getElementById("stress").addEventListener("input", function() {
  document.getElementById("stressVal").textContent = this.value;
});
</script>

</body>
</html>